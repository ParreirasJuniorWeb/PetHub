{
  "name": "pethub-functions",
  "private": true,
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "lint": "echo \"No lint configured for functions\"",
    "test": "jest --config ../jest.config.cjs --runInBand functions/src/__tests__/index.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "^5.9.3"
  }
}
